{
  "name": "homebridge-gsh",
  "displayName": "Homebridge Google Smart Home",
  "type": "module",
  "version": "4.1.0",
  "description": "Google Smart Home",
  "homepage": "https://github.com/homebridge-plugins/homebridge-gsh/blob/latest/README.md",
  "license": "GPL-3.0",
  "author": "NorthernMan54",
  "repository": {
    "url": "git+https://github.com/homebridge-plugins/homebridge-gsh.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-gsh/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "google smart home",
    "google-smart-home",
    "google home",
    "google-home",
    "google assistant",
    "google-assistant",
    "google",
    "android",
    "homebridge",
    "gsh"
  ],
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0",
    "node": ">=18"
  },
  "scripts": {
    "watch": "nodemon",
    "watch:ui": "npm run start --prefix homebridge-ui/public",
    "build": "rimraf dist && npm run build:gen-hap-types && npm run build:plugin && npm run build:ui",
    "build:plugin": "tsc",
    "build:ui": "npm run build --prefix homebridge-ui/public",
    "testbuild:ui": "npm run testbuild --prefix homebridge-ui/public",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix --max-warnings=0 .",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test-coverage": "npm run test -- --coverage",
    "test-watch": "npm run test -- --watch",
    "build:gen-hap-types": "tsx scripts/gen-hap-types.ts"
  },
  "bundledDependencies": [
    "@homebridge/hap-client",
    "@homebridge/ws-connect",
    "fs-extra",
    "rxjs"
  ],
  "dependencies": {
    "@homebridge/hap-client": "^5.1.1",
    "@homebridge/ws-connect": "^3.0.0",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0",
    "rxjs": "^7.8.1",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.13.0",
    "@homebridge/hap-nodejs": "^2.1.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "actions-on-google": "^3.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-format": "^0.1.2",
    "homebridge": "^2.2.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "selenium-webdriver": "^4.46.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "homebridge-ui/public/src"
    ],
    "ext": "ts,html,scss,md",
    "ignore": [
      "**/*.spec.ts",
      "**/*.test.ts"
    ],
    "exec": "rimraf dist && npm run testbuild:ui & tsc & wait && DEBUG= node ~/npm/lib/node_modules/homebridge-config-ui-x/dist/bin/hb-service.js run --stdout -U ./test/hbConfig -T -D -I -P ./",
    "signal": "SIGTERM",
    "env": {
      "NODE_OPTIONS": "--trace-warnings"
    }
  },
  "bundleDependencies": [
    "@homebridge/hap-client",
    "@homebridge/ws-connect",
    "fs-extra",
    "rxjs"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "@swc/core@1.15.47": true
  },
  "overrides": {
    "@types/express-serve-static-core": "4.19.9"
  }
}
